void CameraMotion::OnKyoeiConstants(const float* data, u32 size, bool vertex, u32 slot) {
    static u32 seen = 0;
    if (++seen % 5000 == 1) {
        std::printf("Kyoei camera: %s slot %u size %u first %g %g %g %g [14] %g has_proj %d",
                    vertex ? "vs" : "ps", slot, size, data[0], data[1], data[2], data[3],
                    size > 60 ? data[14] : 0.0f, int(kyoei_has_proj));
        std::putchar(10);
    }
    if (frame_has_camera) {
        return;
    }
    if (vertex) {
        // OpenGL-style perspective: P32 = -1, P33 = 0, depth 0..1 = -P22 + P23 / forward z.
        if (size >= 1600 && size <= 1800 && data[14] == -1.0f && data[15] == 0.0f &&
            data[0] > 0.0f && data[5] > 0.0f && data[10] < 0.0f && data[11] < 0.0f) {
            kyoei_proj = {data[0], data[5], -data[10], data[11]};
            kyoei_has_proj = true;
        }
        return;
    }
    if (slot != 0 || size < 48 || !kyoei_has_proj) {
        return;
    }
    // The view looks down -z; camera_motion.comp wants +z forward: negate the third row.
    std::array<float, 12> v{};
    std::memcpy(v.data(), data, sizeof(v));
    static const bool inverse = [] {
        const char* env = std::getenv("KYOEI_CAMERA_INVERSE");
        return env && env[0] == '1';
    }();
    if (inverse) {
        // The constants hold the camera's world matrix: invert it into a view first.
        std::array<float, 12> w = v;
        for (int r = 0; r < 3; ++r) {
            for (int c = 0; c < 3; ++c) v[r * 4 + c] = w[c * 4 + r];
            v[r * 4 + 3] = -(w[r] * w[3] + w[4 + r] * w[7] + w[8 + r] * w[11]);
        }
    }
    for (int c = 0; c < 4; ++c) v[8 + c] = -v[8 + c];
    for (int r = 0; r < 3; ++r) {
        const float n = v[r * 4] * v[r * 4] + v[r * 4 + 1] * v[r * 4 + 1] + v[r * 4 + 2] * v[r * 4 + 2];
        if (std::abs(n - 1.0f) > 1e-2f) return; // not a rigid view
    }
    std::array<float, 12> inv{};
    for (int r = 0; r < 3; ++r) {
        for (int c = 0; c < 3; ++c) inv[r * 4 + c] = v[c * 4 + r];
        inv[r * 4 + 3] = -(v[r] * v[3] + v[4 + r] * v[7] + v[8 + r] * v[11]);
    }
    previous = current;
    current.view = v;
    current.inv_view = inv;
    current.proj = kyoei_proj;
    current.valid = true;
    kyoei_has_proj = false;
    frame_has_camera = true;
    static u32 commits = 0;
    if (++commits % 300 == 1) {
        std::printf("Kyoei camera: view t %g %g %g proj %g %g %g %g", v[3], v[7], v[11],
                    kyoei_proj[0], kyoei_proj[1], kyoei_proj[2], kyoei_proj[3]);
        std::putchar(10);
    }
}

